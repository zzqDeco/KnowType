"settings.diagnostics.step.build.title" = "Build and Sign";
"settings.diagnostics.step.build.detail" = "Run the input-method bundle build script. The script prefers an available Apple Development signing identity and falls back to ad-hoc signing only when no certificate is available.";
"settings.diagnostics.step.install.title" = "Install Bundle";
"settings.diagnostics.step.install.detail" = "Copy KnowType.app to ~/Library/Input Methods. The install script cleans stale .Mode development state, then registers and enables the KnowType parent anchor plus visible .Hans input mode from the installed app context. Settings are available from KnowType Settings... in the input-method menu.";
"settings.diagnostics.step.diagnose.title" = "Diagnose Install";
"settings.diagnostics.step.diagnose.detail" = "Run the read-only diagnostics to check bundle metadata, signing, packaged resources, Text Input Source registration, local data paths, and optional Gatekeeper or sandbox log clues.";
"settings.diagnostics.step.select.title" = "Request Switch";
"settings.diagnostics.step.select.detail" = "Activate the text app you want to test, then run the selection script as a preflight. The script asks the installed KnowType app to switch; final acceptance still requires typing a probe in that app.";
"settings.diagnostics.step.enable.title" = "Enable Input Source";
"settings.diagnostics.step.enable.detail" = "If macOS asks whether to allow KnowType as an input method, click Allow. Then open System Settings > Keyboard > Text Input > Input Sources; if it does not switch automatically, manually enable or select KnowType.";
"settings.diagnostics.step.refresh.title" = "Refresh Registration";
"settings.diagnostics.step.refresh.detail" = "If macOS keeps old registration state, run the repair script. It removes stale LaunchServices records, disables legacy .Mode registrations, restores the visible .Hans input mode, repairs history, and retests switching.";
"settings.diagnostics.step.logs.title" = "View Logs";
"settings.diagnostics.step.logs.detail" = "During local smoke tests, use diagnostics log mode, Console.app, or the log command to inspect KnowTypeInputMethodApp, Gatekeeper, and input-source sandbox messages.";
